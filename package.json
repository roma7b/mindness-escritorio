{
  "name": "mindness-escritorio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.functions.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "pages": "wrangler pages dev dist --kv OFFICE --env-file .dev.vars --port 8788 --ip 127.0.0.1 --show-interactive-dev-session=false",
    "test": "tsx --test shared/*.test.ts",
    "types": "wrangler types",
    "import-logs": "tsx scripts/import-logs.ts",
    "check": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.functions.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "wrangler": "^4.156.0"
  }
}
