{
  "name": "mindness-escritorio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.functions.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "pages": "wrangler pages dev dist --kv OFFICE --env-file .dev.vars --port 8788 --ip 127.0.0.1 --show-interactive-dev-session=false",
    "test": "tsx --test shared/*.test.ts",
    "types": "wrangler types",
    "import-logs": "tsx scripts/import-logs.ts",
    "check": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.functions.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
